# Font
font-family = BlexMono Nerd Font Mono
font-size = 16

# Theme
theme = Oxocarbon
background-opacity = 1

# Match Kitty behavior
window-padding-x = 0
window-padding-y = 0
copy-on-select = false
clipboard-trim-trailing-spaces = false
unfocused-split-opacity = 1
window-decoration = auto

# Copy selection with Ctrl+C; otherwise send Ctrl+C to the terminal
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = super+t=new_tab

# Send Cmd+arrows to Herdr as modified-arrow sequences.
keybind = super+arrow_left=text:\x1b[1;9D
keybind = super+arrow_right=text:\x1b[1;9C
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5
keybind = super+6=goto_tab:6
keybind = super+7=goto_tab:7
keybind = super+8=goto_tab:8
keybind = super+9=goto_tab:9

# Cycle Herdr workspaces using single-byte direct bindings.
keybind = super+arrow_up=text:\x1c
keybind = super+arrow_down=text:\x1e

# Minimal macOS chrome while retaining tabs
macos-titlebar-style = tabs
macos-window-buttons = visible
